<Window x:Class="NobatQeshm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سامانه نوبت قشم" Icon="Assets/icon.ico"
        Style="{StaticResource PersianWindow}" UseLayoutRounding="True"
        Width="888" Height="822" MinWidth="800" MinHeight="640"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" BorderBrush="#122F45"
                BorderThickness="1" CornerRadius="7" Padding="16,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="Assets/icon.ico" Width="50" Height="50" Margin="10,0" FlowDirection="LeftToRight"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="سامانه نوبت قشم" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SessionHeaderText" Text="وضعیت ورود نامشخص" Foreground="#D2E2EE"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="پلاک‌های ذخیره‌شده" Click="ManageSavedPlates_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="ورود">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="حساب‌های ذخیره‌شده">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="SavedAccountsCombo" Grid.Column="0" DisplayMemberPath="Display" SelectionChanged="SavedAccountsCombo_SelectionChanged"/>
                                <Button Grid.Column="1" Content="ورود با حساب" Click="RestoreSession_Click" Style="{StaticResource SuccessButton}"/>
                                <Button Grid.Column="2" Content="حذف حساب" Click="DeleteSession_Click" Style="{StaticResource DangerButton}"/>
                                <TextBlock x:Name="SavedAccountStatusText" Grid.Column="3" Margin="12,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="ورود با کد ملی و موبایل">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Label Content="کد ملی" Target="{Binding ElementName=NationalCodeText}"/>
                                    <TextBox x:Name="NationalCodeText" Grid.Column="1" MaxLength="10" TextAlignment="Center" FlowDirection="LeftToRight"/>
                                    <Label Grid.Column="2" Content="شماره موبایل" Target="{Binding ElementName=MobileText}" Margin="8,0"/>
                                    <TextBox x:Name="MobileText" Grid.Column="3" MaxLength="11" TextAlignment="Center" FlowDirection="LeftToRight"/>
                                </Grid>
                                <Border Style="{StaticResource CardStyle}" Background="#F8FAFC" Margin="4,10,4,4">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Label Content="کد امنیتی" Target="{Binding ElementName=CaptchaText}"/>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White"
                                                    CornerRadius="4" Width="210" Height="68" Margin="4">
                                                <Image x:Name="CaptchaImage" Stretch="Uniform" Margin="3" FlowDirection="LeftToRight"
                                                       AutomationProperties.Name="تصویر کد امنیتی"/>
                                            </Border>
                                            <TextBox x:Name="CaptchaText" FontSize="18" FontWeight="Bold" MaxLength="5" TextAlignment="Center"
                                                     Width="92" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                            <Button x:Name="RefreshCaptchaButton" Content="تصویر جدید" Click="RefreshCaptcha_Click"
                                                    VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"/>
                                            <CheckBox x:Name="AutoCaptchaCheck" Content="تشخیص خودکار" IsChecked="True" VerticalAlignment="Center" Margin="10,0"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="CaptchaStatusText" Text="در حال دریافت تصویر…" Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="4,6,4,0"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="RequestOtpButton" Content="ارسال کد فعال‌سازی" Click="RequestOtp_Click"
                                        IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource SuccessButton}"/>
                                <Separator Margin="4,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Label Content="کد فعال‌سازی"/>
                                    <PasswordBox x:Name="OtpText" Grid.Column="1" MaxLength="12" FlowDirection="LeftToRight"/>
                                    <Button Grid.Column="2" Content="تأیید و ورود" Click="VerifyOtp_Click" Style="{StaticResource SuccessButton}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="LoginStatusTitle" Text="وضعیت ورود" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="LoginStatusText" Text="هنوز وارد نشده‌اید." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="نوبت‌دهی">
                <TabControl x:Name="ReservationTabs" Margin="6">
                    <TabItem Header="نوبت جدید">
                        <Grid Margin="6">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <GroupBox Header="خدمت و اطلاعات خودرو">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Width="282">
                                            <Label Content="پلاک ذخیره‌شده" Target="{Binding ElementName=SavedPlateBookingCombo}"/>
                                            <ComboBox x:Name="SavedPlateBookingCombo" DisplayMemberPath="Display" SelectionChanged="SavedPlateBookingCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Width="155">
                                            <Label Content="نوع خدمت" Target="{Binding ElementName=ServiceCombo}"/>
                                            <ComboBox x:Name="ServiceCombo" DisplayMemberPath="Name" SelectionChanged="BookingInput_Changed"/>
                                        </StackPanel>
                                        <StackPanel Width="122">
                                            <Label Content="کد شماره‌گذاری" Target="{Binding ElementName=TransferCodeText}"/>
                                            <TextBox x:Name="TransferCodeText" TextChanged="BookingInput_Changed" TextAlignment="Center" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                        <StackPanel Width="106">
                                            <Label Content="شماره پلاک" Target="{Binding ElementName=ReservationPlateText}"/>
                                            <TextBox x:Name="ReservationPlateText" TextChanged="BookingInput_Changed" TextAlignment="Center" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                        <StackPanel Width="100">
                                            <Label Content="سری (اختیاری)" Target="{Binding ElementName=ReservationSeriesText}"/>
                                            <TextBox x:Name="ReservationSeriesText" TextChanged="BookingInput_Changed" TextAlignment="Center" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="بررسی نوبت‌های آزاد" Click="CheckAvailability_Click" Style="{StaticResource SuccessButton}"/>
                                        <Button Content="به‌روزرسانی خدمات" Click="LoadServices_Click" Style="{StaticResource SecondaryButton}"/>
                                        <TextBlock x:Name="ServicesStatusText" Text="نوع خدمت‌ها پس از ورود دریافت می‌شوند" Foreground="{StaticResource MutedBrush}" Margin="10,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                            <TextBlock x:Name="VehicleInfoText" Grid.Row="1" Margin="10,4" TextWrapping="Wrap"/>
                            <Border Grid.Row="2" x:Name="AvailabilityStatusBorder" Background="#F8FAFC" CornerRadius="5" Padding="10" Margin="6,2">
                                <TextBlock x:Name="AvailabilityStatusText" Text="هنوز نوبت‌های آزاد بررسی نشده‌اند." FontWeight="Bold"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <DataGrid x:Name="AvailableSessionsGrid" Grid.Row="3" Margin="6" SelectionChanged="AvailableSessionsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ردیف" Binding="{Binding Index}" Width="0.65*" ElementStyle="{StaticResource TableCellText}"/>
                                    <DataGridTextColumn Header="شناسه نوبت" Binding="{Binding Id}" Width="1.7*" ElementStyle="{StaticResource TableCellText}"/>
                                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="1.4*" ElementStyle="{StaticResource TableCellText}"/>
                                    <DataGridTextColumn Header="شروع" Binding="{Binding Start}" Width="*" ElementStyle="{StaticResource TableCellText}"/>
                                    <DataGridTextColumn Header="پایان" Binding="{Binding End}" Width="*" ElementStyle="{StaticResource TableCellText}"/>
                                    <DataGridTextColumn Header="باجه" Binding="{Binding Counter}" Width="0.7*" ElementStyle="{StaticResource TableCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button x:Name="ConfirmReservationButton" Grid.Row="4" Content="ثبت نوبت انتخاب‌شده" Click="ConfirmReservation_Click" IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource SuccessButton}"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="نوبت‌های من">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="4,0,4,6">
                                <Button Content="به‌روزرسانی" Click="LoadReservations_Click" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="لیست رزروها" FontWeight="Bold" FontSize="16"/>
                                    <Border Background="#E2EDF7" CornerRadius="11" Padding="9,3" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ReservationCountText" Text="۰ نوبت" Foreground="#1C537A" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ReservationCards" Tag="2" SizeChanged="ReservationCards_SizeChanged">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="5" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                    Background="White" CornerRadius="10">
                                                <StackPanel>
                                                    <Border Background="#EDF4FA" CornerRadius="9,9,0,0" Padding="9">
                                                        <DockPanel>
                                                            <Button Content="{Binding CodeLabel}" IsEnabled="{Binding HasCode}" Click="CopyReservationCode_Click"
                                                                    DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                                                    ToolTip="کپی کد رزرو" MinWidth="0" MinHeight="28" Margin="5,0,0,0" Padding="8,3"/>
                                                            <TextBlock Text="{Binding Service}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <StackPanel Margin="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Background="#F3F7FA" CornerRadius="6" Padding="8" BorderBrush="#E1EAF3"
                                                                    BorderThickness="1" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Plate}" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight"/>
                                                                    <Border Width="1" Height="22" Background="#D2DAE4" Margin="8,0"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="سری" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                                        <TextBlock Text="{Binding Series}" FontWeight="Bold"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                <TextBlock Text="کد شماره‌گذاری" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding TransferCode}" FontWeight="Bold" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Separator Margin="0,8,0,6"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="ساعت" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Time}" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="ثبت شده در" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding CreatedAt}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ReceiptTab" Header="آخرین رسید">
                        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel>
                                <Button x:Name="PrintReceiptButton" Content="چاپ رسید" Click="PrintReceipt_Click" IsEnabled="False" Style="{StaticResource SuccessButton}"/>
                                <Button x:Name="CopyReceiptImageButton" Content="کپی به‌صورت عکس" Click="CopyReceiptImage_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="CopyReceiptCodeButton" Content="کپی کد رزرو" Click="CopyReceiptCode_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="SaveReceiptButton" Content="ذخیرهٔ رسید HTML" Click="SaveReceipt_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="OpenReceiptButton" Content="باز کردن در مرورگر" Click="OpenReceipt_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="تنظیم تبلیغات" Click="ReceiptAdvertising_Click" Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                                <Grid>
                                    <ContentControl x:Name="ReceiptHost" Loaded="ReceiptHost_Loaded"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                                    <TextBlock x:Name="ReceiptPreviewStatus" Text="رسید آخرین نوبت ثبت‌شده اینجا نمایش داده می‌شود."
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem x:Name="MonitorTab" Header="پایش نوبت">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <GroupBox Header="نشست پایش"><DockPanel><ComboBox x:Name="MonitorAccountCombo" Width="360" DisplayMemberPath="Display" SelectionChanged="MonitorAccountCombo_SelectionChanged" DockPanel.Dock="Left"/><TextBlock x:Name="MonitorAccountStatusText" Text="نشست موردنظر برای پایش را انتخاب کنید." Margin="12,0"/></DockPanel></GroupBox>
                    <GroupBox Grid.Row="1" Header="افزودن به پایش"><StackPanel>
                        <WrapPanel>
                            <StackPanel Width="282">
                                <Label Content="پلاک ذخیره‌شده" Target="{Binding ElementName=SavedPlateMonitorCombo}"/>
                                <ComboBox x:Name="SavedPlateMonitorCombo" DisplayMemberPath="Display" SelectionChanged="SavedPlateMonitorCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Width="135">
                                <Label Content="کد شماره‌گذاری" Target="{Binding ElementName=MonitorTransferText}"/>
                                <TextBox x:Name="MonitorTransferText" TextAlignment="Center" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Width="115">
                                <Label Content="شماره پلاک" Target="{Binding ElementName=MonitorPlateText}"/>
                                <TextBox x:Name="MonitorPlateText" TextAlignment="Center" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Width="116">
                                <Label Content="سری (اختیاری)" Target="{Binding ElementName=MonitorSeriesText}"/>
                                <TextBox x:Name="MonitorSeriesText" TextAlignment="Center" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Width="125">
                                <Label Content="فاصله (دقیقه)" Target="{Binding ElementName=MonitorIntervalText}"/>
                                <TextBox x:Name="MonitorIntervalText" Text="5" TextAlignment="Center" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </WrapPanel>
                        <ItemsControl x:Name="MonitorServicesItems" Margin="4"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="8,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <WrapPanel>
                            <CheckBox x:Name="MonitorAlarmCheck" Content="هشدار صوتی" IsChecked="True" VerticalAlignment="Center" Margin="8"/>
                            <ComboBox x:Name="MonitorSoundCombo" Width="230"/>
                            <Button Content="پخش نمونه" Click="PreviewSound_Click" Style="{StaticResource SecondaryButton}"/>
                            <Label Content="تعداد پخش" Target="{Binding ElementName=MonitorAlarmCountText}"/>
                            <TextBox x:Name="MonitorAlarmCountText" Text="3" Width="55" TextAlignment="Center" FlowDirection="LeftToRight"/>
                            <CheckBox x:Name="MonitorBalloonCheck" Content="اعلان دسکتاپ" IsChecked="True" VerticalAlignment="Center" Margin="8"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="AddMonitorButton" Content="افزودن و بررسی فوری" Click="AddMonitor_Click" IsEnabled="False" Style="{StaticResource SuccessButton}"/>
                            <Button x:Name="RefreshMonitorServicesButton" Content="به‌روزرسانی خدمات" Click="RefreshMonitorServices_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                    </StackPanel></GroupBox>
                    <DataGrid x:Name="MonitorGrid" Grid.Row="2" Margin="6"><DataGrid.Columns><DataGridTextColumn Header="اطلاعات پلاک" Binding="{Binding Vehicle}" Width="1.7*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="خدمت" Binding="{Binding ServiceName}" Width="1.3*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="فاصله" Binding="{Binding Interval}" Width="0.7*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="آخرین بررسی" Binding="{Binding LastTime}" Width="*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="بررسی بعدی" Binding="{Binding NextTime}" Width="1.15*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="هشدار" Binding="{Binding Alarm}" Width="1.1*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="نتیجه" Binding="{Binding Result}" Width="1.55*" ElementStyle="{StaticResource TableCellText}"/></DataGrid.Columns></DataGrid>
                    <DockPanel Grid.Row="3"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="بررسی فوری" Click="CheckMonitorNow_Click"/><Button Content="توقف / ادامه" Click="ToggleMonitor_Click" Style="{StaticResource SecondaryButton}"/><Button Content="حذف سطر" Click="DeleteMonitor_Click" Style="{StaticResource DangerButton}"/></StackPanel><TextBlock x:Name="MonitorSummaryText" Text="هنوز موردی به پایش اضافه نشده است." Margin="12,0"/></DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="مشخصات">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel><Button Content="به‌روزرسانی مشخصات" Click="LoadProfile_Click" DockPanel.Dock="Left"/><TextBlock x:Name="ProfileStatusText" Text="پس از ورود به‌صورت خودکار بارگذاری می‌شود" Margin="12,0"/></DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="7" Padding="20" Margin="8"><DockPanel>
                            <Border DockPanel.Dock="Left" Background="White" Width="130" Height="150" Margin="0,0,0,0"><Image x:Name="ProfileImage" Stretch="UniformToFill"/></Border>
                            <StackPanel Margin="20" VerticalAlignment="Center"><TextBlock x:Name="ProfileNameText" Text="مشخصات کاربر هنوز بارگذاری نشده است" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="ProfileMetaText" Foreground="#CBD5E1" Margin="0,8,0,0"/><TextBlock x:Name="ProfileContactText" Foreground="#94A3B8" Margin="0,8,0,0"/></StackPanel>
                        </DockPanel></Border>
                        <GroupBox Header="اطلاعات فردی"><ItemsControl x:Name="PersonalFields"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Background="#F8FAFC" Width="450"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
                        <GroupBox Header="اطلاعات اقامت"><ItemsControl x:Name="ResidenceFields"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Background="#F8FAFC" Width="450"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
                        <GroupBox Header="اطلاعات شغلی"><ItemsControl x:Name="JobFields"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Background="#F8FAFC" Width="450"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
                        <GroupBox Header="اطلاعات تکمیلی"><ItemsControl x:Name="ExtraFields"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Background="#F8FAFC" Width="450"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="پلاک‌ها">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="AddPlateButton" Content="افزودن" Click="AddPlate_Click" Style="{StaticResource SuccessButton}"/><Button Content="بارگذاری لیست" Click="LoadPlates_Click"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="صفحه قبل" Click="PreviousPlatePage_Click" Style="{StaticResource SecondaryButton}"/><Button Content="صفحه بعد" Click="NextPlatePage_Click" Style="{StaticResource SecondaryButton}"/><TextBlock x:Name="PlatePageText" Text="صفحه ۱" Margin="10,0"/></StackPanel></DockPanel>
                    <TextBlock x:Name="PlateAddInfoText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="8,4" TextWrapping="Wrap"/>
                    <DataGrid x:Name="PlatesGrid" Grid.Row="2" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پلاک" Binding="{Binding Plate}" Width="1.3*" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding Date}" Width="*" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTextColumn Header="علت رد" Binding="{Binding Reject}" Width="2*" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTemplateColumn Header="عملیات" Width="216"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel><Button Content="ویرایش" Click="EditPlate_Click" MinWidth="58" MinHeight="28"/><Button Content="حذف" Click="DeletePlate_Click" Style="{StaticResource DangerButton}" MinWidth="60" MinHeight="28"/><Button Content="روی کارت" Click="ViewFrontPlateImage_Click" Style="{StaticResource SecondaryButton}" MinWidth="70" MinHeight="28"/><Button Content="پشت کارت" Click="ViewBackPlateImage_Click" Style="{StaticResource SecondaryButton}" MinWidth="70" MinHeight="28"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="نرخ خدمات">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button Content="دریافت نرخ‌ها" Click="LoadPrices_Click" HorizontalAlignment="Left"/>
                    <DataGrid x:Name="PricesGrid" Grid.Row="1" Margin="6"><DataGrid.Columns><DataGridTextColumn Header="شناسه" Binding="{Binding Id}" Width="0.8*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="نوع خدمت / خودرو" Binding="{Binding Type}" Width="3*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="مبلغ" Binding="{Binding FormattedPrice}" SortMemberPath="Price" Width="1.15*" ElementStyle="{StaticResource TableCellText}"/></DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="تردد">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="بارگذاری" Click="LoadTraffic_Click"/><Button Content="صفحه قبل" Click="PreviousTrafficPage_Click" Style="{StaticResource SecondaryButton}"/><Button Content="صفحه بعد" Click="NextTrafficPage_Click" Style="{StaticResource SecondaryButton}"/><TextBlock x:Name="TrafficPageText" Text="صفحه ۱" Margin="10,0"/></StackPanel><Button Content="نمایش/بستن جزئیات" Click="ToggleTrafficDetails_Click" Style="{StaticResource SecondaryButton}"/></DockPanel>
                    <DataGrid x:Name="TrafficGrid" Grid.Row="1" Margin="6" SelectionChanged="TrafficGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="شناسه" Binding="{Binding Id}" Width="0.8*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="تاریخ / ساعت" Binding="{Binding Date}" Width="1.3*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="پلاک" Binding="{Binding Plate}" Width="1.3*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="0.65*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="1.15*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="مبلغ" Binding="{Binding Price}" Width="1.15*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="پیگیری" Binding="{Binding Trace}" Width="1.15*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="پرداخت" Binding="{Binding Payment}" Width="*" ElementStyle="{StaticResource TableCellText}"/></DataGrid.Columns></DataGrid>
                    <GroupBox x:Name="TrafficDetailsBox" Grid.Row="2" Header="جزئیات سطر انتخاب‌شده" Visibility="Collapsed"><TextBox x:Name="TrafficDetailsText" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FlowDirection="LeftToRight"/></GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="تشخیص API">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="قرارداد مدیریت پلاک" Click="PlateContract_Click"/><Button Content="قرارداد ثبت نوبت" Click="ReservationContract_Click"/><Button Content="وضعیت ورود / CSRF" Click="AuthDiagnostics_Click"/></StackPanel>
                    <TextBox x:Name="DiagnosticsText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" FlowDirection="LeftToRight"/>
                </Grid>
            </TabItem>

            <TabItem Header="درباره برنامه">
                <ScrollViewer><StackPanel Margin="10">
                    <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="7" Padding="22"><DockPanel><Image Source="Assets/icon.ico" Width="84" Height="84" DockPanel.Dock="Left" Margin="0,0,18,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="سامانه نوبت قشم" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="نسخه بومی C# / WPF — نوبت‌دهی و پایش خدمات تعویض پلاک قشم" Foreground="#D2E2EE" Margin="0,8,0,0"/></StackPanel></DockPanel></Border>
                    <GroupBox Header="سازنده"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="برنامه‌نویس" FontWeight="Bold"/><TextBlock Text="تماس" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Farhad Farhadi"/><TextBlock Text="09361263005" Margin="0,8,0,0"/></StackPanel></Grid></GroupBox>
                    <GroupBox Header="مشخصات سیستم"><DataGrid x:Name="SystemInfoGrid"><DataGrid.Columns><DataGridTextColumn Header="مشخصه" Binding="{Binding Label}" Width="*" ElementStyle="{StaticResource TableCellText}"/><DataGridTextColumn Header="مقدار" Binding="{Binding Value}" Width="2*" ElementStyle="{StaticResource TableCellText}"/></DataGrid.Columns></DataGrid></GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>

        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="گزارش عملیات" Click="ToggleLog_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"/>
            <ProgressBar x:Name="BusyProgress" Width="150" Height="8" IsIndeterminate="True" Visibility="Collapsed" Margin="10" DockPanel.Dock="Right"/>
            <Border Background="#E1EAF3" Padding="10,8" CornerRadius="4"><TextBlock x:Name="StatusText" Text="آماده"/></Border>
        </DockPanel>
    </Grid>
</Window>
