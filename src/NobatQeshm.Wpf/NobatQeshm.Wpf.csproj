<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyTitle>سامانه نوبت قشم</AssemblyTitle>
    <Product>سامانه نوبت قشم</Product>
    <Version>1.0.9</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\receipt_template.html" LogicalName="NobatQeshm.ReceiptTemplate.html" />
    <EmbeddedResource Include="$(ActivationSmsKeyFile)" LogicalName="NobatQeshm.ActivationSmsKey"
                      Condition="'$(ActivationSmsKeyFile)' != ''" />
  </ItemGroup>
  <Target Name="RequireActivationSmsKeyForPublish" BeforeTargets="PrepareForPublish"
          Condition="!Exists('$(ActivationSmsKeyFile)')">
    <Error Text="Publishing requires ActivationSmsKeyFile to point to the SMS provider key file." />
  </Target>
</Project>

