<Window x:Class="NobatQeshm.Wpf.ServiceAvailabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بررسی همه خدمات" Style="{StaticResource PersianWindow}"
        Width="660" Height="490" MinWidth="500" MinHeight="340"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="به‌روزرسانی" Click="Refresh_Click"/>
            <TextBlock x:Name="VehicleText" FontWeight="Bold" TextWrapping="Wrap" Margin="4"/>
        </DockPanel>
        <DataGrid x:Name="ServiceGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نام خدمت" Binding="{Binding ServiceName}" Width="2*"
                                    ElementStyle="{StaticResource TableCellText}"/>
                <DataGridTextColumn Header="ظرفیت (بازهٔ آزاد)" Binding="{Binding Capacity}" Width="*"
                                    ElementStyle="{StaticResource TableCellText}"/>
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="2*"
                                    ElementStyle="{StaticResource TableCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="4,10,4,0"
                   Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
