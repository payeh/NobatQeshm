<Window x:Class="NobatQeshm.Wpf.AppointmentNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PersianWindow}" Title="اعلان پایش نوبت"
        Width="390" WindowStartupLocation="Manual" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Loaded="Notification_Loaded">
    <Border Background="White" BorderBrush="#A8BFD2" BorderThickness="1" CornerRadius="12" Margin="7">
        <Border.Effect><DropShadowEffect Color="#183852" BlurRadius="15" ShadowDepth="1" Opacity="0.2"/></Border.Effect>
        <StackPanel>
            <Border Background="#153852" Padding="12,7" CornerRadius="11,11,0,0">
                <DockPanel>
                    <Button Content="×" Click="Dismiss_Click" DockPanel.Dock="Right" ToolTip="بستن اعلان"
                            MinWidth="27" MinHeight="27" Padding="4,0" Margin="0" FontSize="17"/>
                    <Image Source="Assets/icon.ico" Width="34" Height="34" DockPanel.Dock="Left" FlowDirection="LeftToRight" Margin="0,0,8,0"/>
                    <TextBlock Text="سامانه نوبت قشم" Foreground="White" FontWeight="Bold"/>
                </DockPanel>
            </Border>
            <StackPanel Margin="13,10,13,10">
                <TextBlock x:Name="NotificationTitle" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="NotificationMessage" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                <Button x:Name="OpenButton" Click="Open_Click" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButton}" MinHeight="29" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
