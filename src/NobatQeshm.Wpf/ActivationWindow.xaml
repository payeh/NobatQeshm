<Window x:Class="NobatQeshm.Wpf.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فعال‌سازی برنامه" Style="{StaticResource PersianWindow}"
        Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource CardStyle}" Margin="18" Padding="18">
        <StackPanel>
            <TextBlock Text="فعال‌سازی برنامه" FontSize="20" FontWeight="Bold"
                       Foreground="#153852" TextAlignment="Center"/>
            <TextBlock Text="شمارهٔ دریافت پیامک را انتخاب کنید. بعد از تأیید کد، برنامه ۴۵ روز فعال می‌ماند."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,12"/>
            <Label Content="ارسال کد فعال‌سازی به" Target="{Binding ElementName=DestinationBox}"/>
            <ComboBox x:Name="DestinationBox" FlowDirection="LeftToRight"
                      HorizontalContentAlignment="Center" SelectionChanged="DestinationBox_SelectionChanged"/>
            <Button x:Name="SendCodeButton" Content="ارسال کد فعال‌سازی" Click="SendCodeButton_Click" Margin="4,10,4,4"/>
            <Label Content="کد فعال‌سازی پیامک‌شده" Target="{Binding ElementName=CodeBox}" Margin="0,4,0,0"/>
            <TextBox x:Name="CodeBox" MaxLength="5" FontSize="21" FontWeight="Bold" TextAlignment="Center"
                     FlowDirection="LeftToRight" IsEnabled="False" TextChanged="CodeBox_TextChanged"/>
            <TextBlock x:Name="StatusText" Text="برای درخواست کد روی «ارسال کد فعال‌سازی» کلیک کنید."
                       Foreground="{StaticResource MutedBrush}" MinHeight="36"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="2,8"/>
            <UniformGrid Columns="2" Margin="0,2,0,0">
                <Button x:Name="ActivateButton" Content="تأیید و فعال‌سازی" Click="ActivateButton_Click"
                        IsEnabled="False" IsDefault="True" Style="{StaticResource SuccessButton}"/>
                <Button Content="خروج" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
